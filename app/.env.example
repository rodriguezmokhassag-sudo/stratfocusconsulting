# STFC Academy : copiez ce fichier en .env (ou renseignez ces variables chez votre hébergeur)
NODE_ENV=production
PORT=3000
# URL publique (sert aux retours de paiement et aux liens de vérification des certificats)
BASE_URL=https://academy.stratfocusconsulting.com
DB_FILE=/app/data/stfc.sqlite

# Premier administrateur (créé au premier démarrage s'il n'existe aucun admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paiement CinetPay (laisser vide = mode simulation, aucun débit réel)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Contact et certificat
CONTACT_WHATSAPP=2250000000000
CONTACT_EMAIL=contact@stratfocusconsulting.com
CERT_SIGNATORY_NAME=Directeur pédagogique
CERT_SIGNATORY_TITLE=STFC Academy

# Seuil de réussite des quiz (%) et taux de change indicatifs (1 unité = X FCFA)
PASS_MARK=70
RATE_USD_XOF=600
RATE_MAD_XOF=61
